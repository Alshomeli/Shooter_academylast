{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.mjs",
    "test:isolated": "node --import tsx --test tests/*isolated-db.test.mjs tests/family-payments-release-readiness.test.mjs",
    "supabase:local:start": "node scripts/supabase-local.mjs start",
    "supabase:local:status": "node scripts/supabase-local.mjs status",
    "supabase:local:stop": "node scripts/supabase-local.mjs stop",
    "supabase:local:check": "node scripts/supabase-local.mjs check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "4.20.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.7"
  }
}
